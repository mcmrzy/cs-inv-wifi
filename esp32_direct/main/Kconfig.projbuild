menu "CS_INV ESP32 Direct Controller"
    config DIRECT_BINDING_PUBLIC_KEY
        string "Cloud binding Ed25519 public key (64 lowercase hex, empty disables)"
        default ""
        help
            Pin the production server public key. Empty preserves UNKNOWN;
            never embed a signing private key in firmware.
    config DIRECT_IDENTITY_PRODUCTION
        bool "Use per-device factory identity (no fixed SN)"
        default n
    config DIRECT_FACTORY_WRITES
        bool "Enable physical USB factory provisioning/test commands"
        default n
        help
            Enable only for factory/commissioning images. Identity lock persists
            across firmware changes. Shipping builds provide inspection only.


    config DIRECT_BOOT_DIAGNOSTICS
        bool "Periodic USB boot diagnostics"
        default n
        help
            Report startup stage every 2 seconds. Buzzer is disabled at
            application entry; startup does not wait for USB reconnection.

    config DIRECT_BUZZ_PIN
        int "Buzzer GPIO (-1 disables buzzer output)"
        default 8

    config DIRECT_BUZZ_ACTIVE_LEVEL
        int "Buzzer active level (0 or 1)"
        range 0 1
        default 1

    config DIRECT_DSP_TX_PIN
        int "DSP UART TX GPIO (-1 disables direct bus)"
        default -1

    config DIRECT_DSP_RX_PIN
        int "DSP UART RX GPIO (-1 disables direct bus)"
        default -1

    config DIRECT_BMS_TX_PIN
        int "BMS UART TX GPIO (-1 disables direct bus)"
        default -1

    config DIRECT_BMS_RX_PIN
        int "BMS UART RX GPIO (-1 disables direct bus)"
        default -1

    config DIRECT_BMS_RS485_DE_PIN
        int "BMS RS485 DE/RE GPIO (-1 if transceiver switches direction automatically)"
        default -1

    config DIRECT_CAN_IDLE_TX_PIN
        int "Unused CAN transceiver TX GPIO held recessive (-1 disables)"
        range -1 21
        default -1
        help
            Hold the unused CAN transceiver D input high at application entry.
            This pin must not also connect to LCD CS or another peripheral.

    choice DIRECT_BMS_PROTOCOL
        prompt "Direct BMS application protocol"
        default DIRECT_BMS_7C
        config DIRECT_BMS_MODBUS
            bool "Modbus 0x03, 37 registers"
        config DIRECT_BMS_7C
            bool "Private 0x7C telemetry"
    endchoice

    config DIRECT_LCD_ISOLATION_TEST
        bool "LCD-only isolation loop (no wireless or business startup)"
        depends on DIRECT_LCD_4WIRE && !DIRECT_LCD_GPIO_SPI
        default n
        help
            Dedicated diagnostic image: red, green, blue, black, white and
            checkerboard forever. Build with a 20 MHz hardware SPI clock.

    config DIRECT_LCD_COLOR_TEST
        bool "Run LCD RGB startup test"
        default n
        help
            Diagnostic color sequence. Disable for normal touch/menu operation.

    config DIRECT_LCD_SCLK_PIN
        int "ST7789 SCLK GPIO (-1 disables panel)"
        default -1
    config DIRECT_LCD_MOSI_PIN
        int "ST7789 MOSI GPIO"
        default -1
    choice DIRECT_LCD_INTERFACE
        prompt "ST7789 serial interface"
        default DIRECT_LCD_4WIRE
        config DIRECT_LCD_3WIRE
            bool "3-line, 9-bit SPI (external D/C fixed high)"
        config DIRECT_LCD_4WIRE
            bool "4-line, 8-bit SPI (GPIO drives D/C)"
    endchoice
    config DIRECT_LCD_GPIO_SPI
        bool "LCD diagnostic using GPIO software SPI"
        depends on DIRECT_LCD_4WIRE && DIRECT_BOOT_DIAGNOSTICS
        default n
        help
            Bypass the SPI peripheral. Drive mode-0, MSB-first bytes with
            2 microseconds per half-cycle and yield between pixel batches.
    config DIRECT_LCD_SPI_CLOCK_HZ
        int "LCD hardware SPI clock in Hz"
        range 100000 40000000
        default 8000000
        help
            Applies to hardware SPI only. Validate wiring before increasing.
    config DIRECT_LCD_MINIMAL_INIT
        bool "ST7789 minimal initialization using factory power/gamma defaults"
        depends on DIRECT_LCD_4WIRE
        default n
        help
            Reset and use the controller's factory power/gamma values.
            Configure only sleep exit, orientation, RGB565, RAM byte order
            and display mode. This is a comparison profile for the new module.
    config DIRECT_LCD_READBACK_TERMINAL
        bool "Single LCD register readback diagnostic"
        depends on DIRECT_LCD_GPIO_SPI
        default n
        help
            Write a MADCTL challenge and read it through the shared SDA pin.
            With fixed CS, stop panel transfers afterwards and leave SDA
            high impedance. With GPIO CS, deselect before restoring output
            and continue the display test.
            A failed read does not prove a fault if the module has no readback.
    config DIRECT_LCD_NOCS_BOOT
        bool "Experimental CS-grounded write-only boot profile"
        depends on DIRECT_LCD_CS_PIN = -1 || DIRECT_LCD_CS_FIXED_LOW
        depends on !DIRECT_LCD_READBACK_TERMINAL
        default n
        help
            Hold RESET low at application entry, park SCL high, disable
            GPIO probes and all register reads, then send mode-3 bytes.
            Requires a dedicated display bus. Physical startup validation
            is required; the application cannot control ROM pin states.
    config DIRECT_LCD_CS_PIN
        int "ST7789 CS GPIO (-1 when CS is tied active)"
        default -1
    config DIRECT_LCD_CS_FIXED_LOW
        bool "Hold LCD CS GPIO permanently low"
        depends on DIRECT_LCD_4WIRE && DIRECT_LCD_CS_PIN >= 0
        depends on !DIRECT_LCD_READBACK_TERMINAL
        default n
        help
            Drive CS low before reset release; never deselect it during
            writes. Dedicated display bus and write-only communication.
    config DIRECT_LCD_DC_PIN
        int "ST7789 D/C GPIO (required only in 4-line mode)"
        default -1
    config DIRECT_LCD_RST_PIN
        int "ST7789 reset GPIO (-1 when reset is external)"
        default -1
    config DIRECT_LCD_BL_PIN
        int "ST7789 backlight GPIO (-1 when always powered externally)"
        default -1
    config DIRECT_KEY_ROW_UP_PIN
        int "Matrix key UP row GPIO (-1 disables keys)"
        default -1
    config DIRECT_KEY_ROW_DOWN_PIN
        int "Matrix key DOWN row GPIO"
        default -1
    config DIRECT_KEY_ESC_PIN
        int "Matrix key ESC column GPIO"
        default -1
    config DIRECT_KEY_ENTER_PIN
        int "Matrix key ENTER column GPIO"
        default -1
    config DIRECT_KEY_CLOCK_PIN
        int "BS818A_2 key clock GPIO (-1 disables keys)"
        default -1
    config DIRECT_KEY_DATA_PIN
        int "BS818A_2 key data GPIO"
        default -1
    choice DIRECT_KEY_PROTOCOL
        prompt "Panel key hardware"
        default DIRECT_KEY_BS818A
        config DIRECT_KEY_BS818A
            bool "BS818A_2 serial touch keys (App(10) active branch)"
        config DIRECT_KEY_MATRIX
            bool "Legacy four-wire key matrix"
    endchoice

    config CS_INV_UART_TX_PIN
        int "UART TX GPIO (U0TXD)"
        default 1

    config CS_INV_UART_RX_PIN
        int "UART RX GPIO (U0RXD)"
        default 0

    config CS_INV_UART_BAUD
        int "UART baudrate"
        default 115200

    config CS_INV_WIFI_SSID
        string "WiFi SSID (NVS 无配置时使用, 留空则等待)"
        default ""

    config CS_INV_WIFI_PASS
        string "WiFi password"
        default ""

    config CS_INV_MQTT_HOST
        string "MQTT broker host"
        default "mqtt.jiuxiaoyw.online"

    config CS_INV_MQTT_PORT
        int "MQTT broker port"
        default 8883

    config CS_INV_MQTT_USERNAME
        string "MQTT username"
        default "CSKJ-INV-DEVICE-6K2"

    config CS_INV_MQTT_PASSWORD
        string "MQTT password"
        default "CSKJINVDEVICE6K2"

    config CS_INV_CACHE_MAX_ITEMS
        int "Offline cache max items"
        default 500

    config CS_INV_CACHE_TTL_DAYS
        int "Offline cache TTL days"
        default 7

    config DIRECT_DSP_OTA_PACKET0_PROBE
        bool "Diagnostic ONLY: erase DSP, send one packet, capture 2s, keep Boot"
        default n
        help
            Destructive diagnostic image. A DSP OTA request sends only packet 0
            once, captures its raw reply, and never reports upgrade success or
            sends EOT. DSP polling stays paused until a new job or explicit exit.
            Keep disabled for normal full-image upgrades.

endmenu
