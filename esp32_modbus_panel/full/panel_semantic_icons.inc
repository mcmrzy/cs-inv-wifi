static void product_icon(lv_draw_ctx_t *ctx,unsigned icon,int x,int y,uint32_t color)
{
 if(icon>=16)return;
 for(unsigned row=0;row<16;row++)for(unsigned col=0;col<16;){
  uint16_t mask=product_glyphs[icon][row];
  if(!(mask&(0x8000U>>col))){col++;continue;}
  unsigned first=col++;
  while(col<16 && (mask&(0x8000U>>col)))col++;
  icon_bar(ctx,x+(int)first*2,y+(int)row*2,(int)(col-first)*2,2,color);
 }
}
