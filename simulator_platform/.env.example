# 认领模拟平台环境变量样例（复制为 .env 使用）
PORT=8080

# ---- MQTT（对齐 ESP32 固件 mqtt.jiuxiaoyw.online:8883 mqtts） ----
MQTT_HOST=mqtt.jiuxiaoyw.online
MQTT_PORT=8883
MQTT_USERNAME=CSKJ-INV-DEVICE-6K2
MQTT_PASSWORD=CSKJINVDEVICE6K2
# 1=TLS(8883, 跳过证书校验对齐固件) 0=明文
MQTT_TLS=1

# ---- 可选：真实天气 ----
# 默认用 Open-Meteo（免费、无需 key）按城市经纬度拉取实时云量/温度/湿度，
# 拉取失败自动回退内置气候模拟。若未来接和风/OpenWeather，在此填 key 并在 weather-provider.js 扩展分支。
WEATHER_API_KEY=
# 0=真实天气(Open-Meteo)，1=仅内置气候模拟（联调省外网）
WEATHER_DISABLE=0

# ---- 数据目录 ----
DATA_DIR=./data
