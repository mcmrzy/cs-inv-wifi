# ESP32-C3 ARM 替代实验工程，沿用 L10 网络参数基线
# WiFi STA + BLE 配网(NimBLE) + MQTT + DSP/BMS 直连 + ESP OTA

# ---- Target (必须指定, 防止删除 sdkconfig 后变回 esp32) ----
CONFIG_IDF_TARGET="esp32c3"

# ---- Flash ----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- 用户提供的 ESP32-C3-WROOM-02UD-N4 原理图片段 ----
# ARM PA2(TX) -> SCIRX-DSP' -> ESP IO1；PA3(RX) -> SCITX-DSP' -> ESP IO0。
# IO2/3: BS818A KEY_CLK/DAT; IO6/7/10: TFT SPI SCK/MOSI/RESET。
# ARM PB14 是 D/C，网名 SPI2_MISO -> ESP IO9（BOOT 共享）；上拉不等于固定高。
# 屏幕 NSS 已独立硬件下拉；GPIO4 保留给 U30 CAN D，固定高以释放总线。
# BMS UART 经 Q3 自动换向的 RS485 收发器，DE=-1。
CONFIG_DIRECT_DSP_TX_PIN=1
CONFIG_DIRECT_DSP_RX_PIN=0
CONFIG_DIRECT_BMS_TX_PIN=21
CONFIG_DIRECT_BMS_RX_PIN=20
CONFIG_DIRECT_BMS_7C=y
CONFIG_DIRECT_CAN_IDLE_TX_PIN=4
CONFIG_DIRECT_BUZZ_PIN=8
CONFIG_DIRECT_BUZZ_ACTIVE_LEVEL=1
CONFIG_DIRECT_KEY_CLOCK_PIN=2
CONFIG_DIRECT_KEY_DATA_PIN=3
CONFIG_DIRECT_LCD_SCLK_PIN=6
CONFIG_DIRECT_LCD_MOSI_PIN=7
CONFIG_DIRECT_LCD_RST_PIN=10
CONFIG_DIRECT_LCD_4WIRE=y
CONFIG_DIRECT_LCD_DC_PIN=9
CONFIG_DIRECT_LCD_CS_PIN=-1
# CONFIG_DIRECT_LCD_CS_FIXED_LOW is not set
CONFIG_DIRECT_LCD_MINIMAL_INIT=y

# 旧 L10 配置项只供尚未清理的兼容代码编译，不再初始化 ARM 串口。
CONFIG_CS_INV_UART_TX_PIN=0
CONFIG_CS_INV_UART_RX_PIN=1
CONFIG_CS_INV_UART_BAUD=115200

# ---- Console (主输出切到 USB-Serial/JTAG, 释放 UART0) ----
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# GPIO21 is BMS TX at runtime, but the ROM uses it as default UART0 TX.
# First execution burns UART_PRINT_CONTROL=3 permanently; later boots are silent.
# USB Serial/JTAG logs and both application UARTs remain available.
CONFIG_BOOT_ROM_LOG_ALWAYS_ON=n
CONFIG_BOOT_ROM_LOG_ALWAYS_OFF=y

# ---- WiFi 内存优化 ----
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=4

# ---- 欠压检测；C3 电源阈值需按新板实测 ----
CONFIG_ESP_BROWNOUT_DET=y

# ---- mbedTLS (自有固定服务器跳过证书验证; 禁用 bundle 省 Flash) ----
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n

# ---- esp-tls (无 CA 时默认跳过证书验证, 配合不配置 certificate 使用) ----
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
# 保留 HTTPS/CDN 的 16KB TLS 记录接收能力；缩小 IN 会导致 OTA 读响应失败。
# 动态缓冲按实际记录分配，处理完成后释放，避免空闲 MQTT 常驻 16KB RX。
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
# 收到大记录时仍需足够的连续内部 RAM；MQTT + HTTPS OTA 峰值需实机验证。
# 不提前释放共享 TLS 配置/证书，保留重连时使用它们的能力。
# CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA is not set
# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set
# CONFIG_MBEDTLS_PKCS7_C is not set

# ---- OTA (esp_http_client HTTPS) ----
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
# coredump 不启用: 分区表不动 → OTA 即可升级; PANIC 取证走 USB-Serial/JTAG
# 现场抓 (idf.py monitor 下复现, Guru Meditation backtrace +
# riscv32-esp-elf-addr2line -pfiaC -e build/cs_inv_direct_c3.elf <地址> 定位)。

# ---- BLE NimBLE 配网 + 本地控制 (仅 PERIPHERAL, 省 RAM) ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=2
CONFIG_BT_NIMBLE_MAX_CCCDS=8
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=4
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=4
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=4
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=2
CONFIG_BT_NIMBLE_LOW_SPEED_MODE=y
# ---- BLE 安全：启用绑定持久化（重启后仍记住已配对手机） ----
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
# SM_LVL: 1=拒绝一切配对(do not pair), 2=允许无认证配对(Just Works)。
# "Pairing Failed (Command Not Supported)" 拒绝。
CONFIG_BT_NIMBLE_SM_LVL=2
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# ---- 不使用 HID 服务：Android 系统蓝牙会把 HID 设备当键盘/鼠标走
# 特殊配对流程，与本设备不兼容(表现为配对失败)。保持普通 BLE 外设身份。 ----
# CONFIG_BT_NIMBLE_HID_SERVICE is not set
# CONFIG_BT_NIMBLE_PROX_SERVICE is not set
# CONFIG_BT_NIMBLE_ANS_SERVICE is not set
# CONFIG_BT_NIMBLE_CTS_SERVICE is not set
# CONFIG_BT_NIMBLE_HTP_SERVICE is not set
# CONFIG_BT_NIMBLE_IPSS_SERVICE is not set
# CONFIG_BT_NIMBLE_TPS_SERVICE is not set
# CONFIG_BT_NIMBLE_IAS_SERVICE is not set
# CONFIG_BT_NIMBLE_LLS_SERVICE is not set
# CONFIG_BT_NIMBLE_SPS_SERVICE is not set
# CONFIG_BT_NIMBLE_HR_SERVICE is not set
# CONFIG_BT_NIMBLE_BAS_SERVICE is not set
# CONFIG_BT_NIMBLE_DIS_SERVICE is not set
# CONFIG_BT_NIMBLE_DTM_MODE_TEST is not set

# ---- MQTT ----
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_BUFFER_SIZE=4096
CONFIG_MQTT_TASK_STACK_SIZE=8192

# ---- 系统 ----
CONFIG_XTAL_FREQ_40=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_TIMER_TASK_STACK_SIZE=3584

# ---- SNTP ----
CONFIG_LWIP_SNTP_MAX_SERVERS=1

CONFIG_DIRECT_LCD_SPI_CLOCK_HZ=8000000
